					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Entry deleted successfully (204, 200, or auth/not found code)\", function () {",
									"    pm.expect([200, 204, 401, 403, 404]).to.include(pm.response.code);",
									"});"
								],
								"type": "text/javascript"
							}
