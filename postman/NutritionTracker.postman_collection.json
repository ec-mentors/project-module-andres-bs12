				{
					"name": "Create (Login with Google & Get JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"authToken\", jsonData.token);",
									"}",
									"if (jsonData.userResponseDTO && jsonData.userResponseDTO.id) {",
									"    pm.environment.set(\"user_id\", jsonData.userResponseDTO.id);",
									"} else if (jsonData.id) {",
									"    pm.environment.set(\"user_id\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
