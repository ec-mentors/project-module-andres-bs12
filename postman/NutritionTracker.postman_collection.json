{
	"info": {
		"_postman_id": "nutrition-tracker-e2e-suite",
		"name": "NutritionTracker API Test Suite",
		"description": "Suite automatizada de pruebas para NutritionTracker ejecutada con Newman como quality gate antes del despliegue en AWS.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health & Users",
			"item": [
				{
					"name": "Get All Users (Admin / Smoke Test)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 401/403 (Service is reachable)\", function () {",
									"    pm.expect([200, 401, 403]).to.include(pm.response.code);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.test(\"Users list is an array\", function () {",
									"        pm.expect(Array.isArray(jsonData)).to.be.true;",
									"    });",
									"    if (jsonData.length > 0) {",
									"        pm.environment.set(\"testUserId\", jsonData[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"user"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Goals",
			"item": [
				{
					"name": "Create Daily Goal",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Goal created or validation accepted (200, 201 or 401/403)\", function () {",
									"    pm.expect([200, 201, 401, 403]).to.include(pm.response.code);",
									"});",
									"",
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.test(\"Goal has valid ID and kcal\", function () {",
									"        pm.expect(jsonData).to.have.property('id');",
									"        pm.expect(jsonData.kcal).to.eql(2200);",
									"    });",
									"    pm.environment.set(\"testGoalId\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"kcal\": 2200,\n    \"carbs\": 250.0,\n    \"fat\": 70.0,\n    \"protein\": 160.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/goal/{{testUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"goal",
								"{{testUserId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get All Goals For User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or auth restricted\", function () {",
									"    pm.expect([200, 401, 403]).to.include(pm.response.code);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.test(\"Response is an array of goals\", function () {",
									"        pm.expect(Array.isArray(jsonData)).to.be.true;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/goal/user/{{testUserId}}/all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"goal",
								"user",
								"{{testUserId}}",
								"all"
							]
						}
					},
					"response": []
				}
			]
		},
		{
